generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  processing
  completed
  cancelled
}

model Order {
  id            String      @id @default(uuid())
  customerName  String
  customerEmail String
  product       String
  quantity      Int
  status        OrderStatus @default(pending)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}